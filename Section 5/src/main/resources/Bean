<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="org.example.beans.Address" id="addId">
        <constructor-arg  value="10"/>
         <constructor-arg  value="mumbai"/>
       <constructor-arg  value="4444401"/>
    </bean>

    <bean class="org.example.beans.Student" id="stdId">
        <constructor-arg value="Bhaves"/>
       <constructor-arg  value="101"/>
       <constructor-arg  value="80.5"/>
        <constructor-arg  ref="addId"/>
    </bean>

</beans>