<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="org.example.beans.Address" id="addId">
        <property name="houseNo" value="10"/>
        <property name="city" value="mumbai"/>
        <property name="pinCode" value="4444401"/>
    </bean>

    <bean class="org.example.beans.Student" id="stdId">
        <property name="name" value="Bhaves"/>
        <property name="rollNo" value="101"/>
        <property name="mark" value="80.5"/>
        <property name="address" ref="addId"/>
    </bean>

</beans>